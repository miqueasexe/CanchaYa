<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="LeClubAppp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:LeClubAppp.Views"
    Title="LeClub">

    <TabBar>
        <Tab Title="Canchas">
            <ShellContent ContentTemplate="{DataTemplate views:CanchasPage}" Route="CanchasPage" />
        </Tab>

        <Tab Title="Mis Reservas">
            <ShellContent ContentTemplate="{DataTemplate views:MisReservasPage}" Route="MisReservasPage" />
        </Tab>

        <Tab Title="Reservar">
            <ShellContent ContentTemplate="{DataTemplate views:ReservaPage}" Route="ReservaPage" />
        </Tab>
    </TabBar>

</Shell>