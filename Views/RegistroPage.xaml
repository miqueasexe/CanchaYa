<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LeClubAppp.Views.RegistroPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F1F5F9">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="30" VerticalOptions="Center">

            <Label Text="Crear Cuenta" FontSize="32" FontAttributes="Bold" TextColor="#0F172A" HorizontalOptions="Center" />
            <Label Text="Completá tus datos para registrarte" FontSize="15" TextColor="#64748B" HorizontalOptions="Center" Margin="0,0,0,20" />

            <Entry x:Name="txtNombre"
                   Placeholder="Nombre y Apellido"
                   TextColor="#0F172A"
                   PlaceholderColor="#94A3B8"
                   BackgroundColor="#FFFFFF" />

            <Entry x:Name="txtEmail"
                   Placeholder="Correo electrónico"
                   TextColor="#0F172A"
                   PlaceholderColor="#94A3B8"
                   BackgroundColor="#FFFFFF"
                   Keyboard="Email" />

            <Entry x:Name="txtPassword"
                   Placeholder="Contraseña"
                   IsPassword="True"
                   TextColor="#0F172A"
                   PlaceholderColor="#94A3B8"
                   BackgroundColor="#FFFFFF" />

            <Button Text="Registrarse"
                    Clicked="OnRegisterClicked"
                    BackgroundColor="#16A34A"
                    TextColor="#FFFFFF"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="50"
                    Margin="0,10,0,0" />

            <Button Text="Ya tengo cuenta (Volver)"
                    Clicked="OnBackToLoginClicked"
                    TextColor="#64748B"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center"
                    Margin="0,10,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>